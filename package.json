{
  "name": "auto-video-editor",
  "version": "1.0.0",
  "description": "Local topic-based FFmpeg video editor",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:win": "electron-builder --win portable --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.autovideoeditor.desktop",
    "productName": "自动话题剪辑",
    "files": ["app/**/*", "package.json", "README.md"],
    "directories": {"output": "dist"},
    "win": {"target": ["portable"], "signAndEditExecutable": false},
    "mac": {"target": ["dmg", "zip"]}
  }
}
